{
  "name": "uptimecove",
  "type": "module",
  "version": "0.1.0",
  "description": "Edge-native uptime monitoring and status pages on Cloudflare Workers + Astro",
  "author": "Harshal Patil <https://github.com/iharshalp>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iharshalp/UptimeCove.git"
  },
  "homepage": "https://github.com/iharshalp/UptimeCove",
  "bugs": {
    "url": "https://github.com/iharshalp/UptimeCove/issues"
  },
  "keywords": ["uptime", "monitoring", "status-page", "cloudflare", "workers", "d1", "astro"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "deploy": "astro build && wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.2.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.126.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
