{
	"name": "UptimeCove — Edge-native uptime monitoring",
	"short_name": "UptimeCove",
	"description": "Free, open-source uptime monitoring and status pages that run entirely on your own Cloudflare account.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#eef1f6",
	"theme_color": "#2563eb",
	"icons": [
		{
			"src": "/favicon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any maskable"
		},
		{
			"src": "/favicon.ico",
			"sizes": "48x48",
			"type": "image/x-icon"
		}
	]
}
