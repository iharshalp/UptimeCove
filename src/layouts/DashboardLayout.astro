---
import Base from './Base.astro';
interface Props {
  title?: string;
  active?: string;
}
const { title = 'Dashboard — UptimeCove', active = 'dashboard' } = Astro.props;
const nav = [
  { id: 'dashboard', label: 'Dashboard', href: '/dashboard', icon: 'M3 13h8V3H3v10zm0 8h8v-5H3v5zm10 0h8V11h-8v10zm0-18v5h8V3h-8z' },
  { id: 'monitors', label: 'Monitors', href: '/dashboard#monitors', icon: 'M22 12h-4l-3 9L9 3l-3 9H2' },
  { id: 'status-pages', label: 'Status Pages', href: '/dashboard/status-pages', icon: 'M12 2v4M12 16v2M8 9h8M5 12h14M12 2a10 10 0 100 20 10 10 0 000-20z' },
  { id: 'maintenance', label: 'Maintenance', href: '/dashboard/maintenance', icon: 'M3 4h18M8 2v4M16 2v4M3 10h18M5 14h3M14 14h3M5 18h3M14 18h3' },
];
---
<Base title={title}>
  <div class="min-h-screen bg-[#eef1f6]">
    <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col bg-white shadow-sm shadow-slate-900/5 lg:flex">
      <a href="/" class="flex items-center gap-2.5 px-7 pt-7 font-bold tracking-tight text-slate-900">
        <span class="flex size-8 items-center justify-center rounded-lg bg-slate-900">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <span class="text-[15px]">Dashboard</span>
        <span class="ml-auto rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[10px] font-semibold tracking-wide text-slate-500">OSS</span>
      </a>
      <div class="px-7 pt-2">
        <a href="https://github.com/iharshalp/UptimeCove" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-slate-700">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          Fork on GitHub
        </a>
      </div>
      <nav class="mt-8 flex-1 space-y-1 overflow-y-auto px-3 pb-4">
        {nav.map((item) => (
          <a href={item.href} class={`flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium transition ${active === item.id ? 'bg-blue-600 text-white shadow-md shadow-blue-600/25' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={active === item.id ? 2.2 : 2} stroke-linecap="round" stroke-linejoin="round"><path d={item.icon} /></svg>
            {item.label}
          </a>
        ))}
        <div class="mt-6 border-t border-slate-100 pt-4">
          <a href="/status/default" target="_blank" class="flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium text-slate-500 hover:bg-slate-50 hover:text-slate-900">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Status Page
          </a>
        </div>
      </nav>
      <div class="border-t border-slate-100 p-3 space-y-2">
        <div class="rounded-xl bg-slate-50 px-3 py-2.5">
          <div class="text-xs font-semibold text-slate-700">Open Source • MIT</div>
          <div class="mt-1 flex flex-wrap gap-2 text-xs">
            <a href="https://github.com/iharshalp/UptimeCove" target="_blank" class="font-medium text-slate-600 hover:text-slate-900">GitHub</a>
            <span class="text-slate-300">•</span>
            <a href="/demo" class="font-medium text-blue-600 hover:underline">Demo</a>
            <span class="text-slate-300">•</span>
            <a href="https://github.com/iharshalp" target="_blank" class="text-slate-500 hover:text-slate-700">iharshalp</a>
          </div>
        </div>
        <form method="POST" action="/api/auth/logout">
          <button class="flex w-full items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium text-slate-500 hover:bg-red-50 hover:text-red-600">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Sign out
          </button>
        </form>
      </div>
    </aside>

    <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-slate-200 bg-white/90 px-4 backdrop-blur lg:hidden">
      <a href="/" class="flex items-center gap-2 text-sm font-semibold text-slate-700">
        <span class="flex size-7 items-center justify-center rounded-lg bg-slate-900"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
        Dashboard
      </a>
      <div class="flex items-center gap-2 text-sm font-medium">
        <a href="/demo" class="hidden text-xs text-slate-500 sm:block">Demo</a>
        <a href="/dashboard" class="rounded-full bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white">App</a>
        <form method="POST" action="/api/auth/logout"><button class="text-xs text-slate-500">Out</button></form>
      </div>
    </header>

    <main class="lg:pl-64">
      <slot />
    </main>
  </div>
</Base>
