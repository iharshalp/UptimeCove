---
import Base from '../../layouts/Base.astro';
import StatusDot from '../../components/StatusDot.astro';
import UptimeBar from '../../components/UptimeBar.astro';
import { env } from 'cloudflare:workers';
import { getStatusPage, getPageMonitors, getDailyUptime, getIncidents, listMaintenanceWindows } from '../../lib/queries';
import { siteName } from '../../lib/site';

const { slug } = Astro.params;
const page = await getStatusPage(env, slug!);
if (!page) return Astro.redirect('/status/default');

const monitors = await getPageMonitors(env, (page as { id: number }).id);

// fetch maintenance windows once
const allWindows = await listMaintenanceWindows(env);
const nowSec = Math.floor(Date.now() / 1000);
const activeWindows = allWindows.filter((w) => w.enabled === 1 && w.start_at <= nowSec && nowSec <= w.end_at);

// helper to check if a monitor is currently in maintenance
function isMonitorInMaintenance(monitorId: number): boolean {
	return activeWindows.some((w) => w.monitor_id === null || w.monitor_id === monitorId);
}

const enriched = await Promise.all(
	monitors.map(async (m) => {
		const [days, incidentsRaw] = await Promise.all([getDailyUptime(env, m.id), getIncidents(env, m.id, 5)]);
		// Hide incidents that fall inside a maintenance window for this monitor (or global)
		const incidents = incidentsRaw.filter((inc) => {
			return !allWindows.some((w) => w.enabled === 1 && inc.started_at >= w.start_at && inc.started_at <= w.end_at && (w.monitor_id === null || w.monitor_id === inc.monitor_id));
		});
		return {
			monitor: m,
			days,
			incidents,
			inMaintenance: isMonitorInMaintenance(m.id),
		};
	})
);

const anyDown = enriched.some((e) => !e.inMaintenance && e.monitor.current_status === 'down');
const allUp = enriched.length > 0 && enriched.every((e) => e.inMaintenance || e.monitor.current_status === 'up');
const banner = anyDown
	? { label: 'Partial outage', cls: 'border-red-200 bg-red-50 text-red-600' }
	: allUp
		? { label: 'All systems operational', cls: 'border-emerald-200 bg-emerald-50 text-emerald-700' }
		: { label: 'Some checks pending', cls: 'border-amber-200 bg-amber-50 text-amber-600' };

function fmtUnix(ts: number | null): string {
	if (!ts) return '—';
	return new Date(ts * 1000).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
}
function duration(started: number, resolved: number | null): string {
	const end = resolved ?? Math.floor(Date.now() / 1000);
	const mins = Math.max(1, Math.round((end - started) / 60));
	return mins < 60 ? `${mins} min` : `${(mins / 60).toFixed(1)} hrs`;
}
function fmtWindow(w: (typeof allWindows)[number]): string {
	return `${fmtUnix(w.start_at)} → ${fmtUnix(w.end_at)}`;
}
---

<Base
	title={`${(page as any).title} — ${siteName()}`}
	description={(page as any).description || `Live service status, 90-day uptime history and incident reports for ${(page as any).title}.`}
>
	<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/85 backdrop-blur">
		<nav class="mx-auto flex h-16 max-w-4xl items-center justify-between px-6">
			<a href="/" class="flex items-center gap-2.5 font-bold text-slate-900">
				<span class="flex size-9 items-center justify-center rounded-xl bg-blue-600 shadow-md shadow-blue-600/25">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg>
				</span>
				UptimeCove
			</a>
			<a href="/dashboard" class="text-sm font-medium text-slate-500 transition hover:text-slate-900">Dashboard →</a>
		</nav>
	</header>

	<main class="hero-glow mx-auto max-w-4xl px-6 pt-12 pb-20">
		<h1 class="text-3xl font-bold tracking-tight text-slate-900">{(page as any).title}</h1>

		{activeWindows.length > 0 && (
			<div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4">
				<div class="flex items-center gap-2 font-semibold text-amber-700">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
					Scheduled maintenance in progress
				</div>
				<ul class="mt-2 space-y-1.5 text-sm text-amber-800/80">
					{activeWindows.map((w) => (
						<li class="flex flex-wrap gap-x-2 gap-y-1">
							<span class="font-semibold">{w.title}</span>
							<span class="font-mono text-xs opacity-70">{fmtWindow(w)} · {w.monitor_name ? w.monitor_name : 'All monitors'}</span>
							{w.description && <span class="w-full text-sm">{w.description}</span>}
						</li>
					))}
				</ul>
				<p class="mt-2 text-xs text-amber-700/60">Checks continue, but alerts and incidents are suppressed during this window.</p>
			</div>
		)}

		<div class={`mt-6 flex flex-wrap items-center gap-3 rounded-2xl border px-5 py-4 font-semibold ${banner.cls}`}>
			<StatusDot status={anyDown ? 'down' : allUp ? 'up' : 'pending'} size="lg" />
			<span>{banner.label}</span>
			<span class="ml-auto flex items-center gap-3 text-xs font-medium opacity-60">
				<span>checked every minute</span>
				<button type="button" onclick="location.reload()" class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-700 shadow-sm ring-1 ring-slate-200 hover:bg-slate-50">Refresh</button>
			</span>
		</div>

		{enriched.length === 0 && (
			<div class="card mt-8 p-10 text-center">
				<p class="font-semibold text-slate-700">No monitors yet</p>
				<p class="mt-1 text-sm text-slate-500">Add your first monitor from the dashboard to see it here.</p>
				<a href="/dashboard" class="mt-5 inline-block rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Add a monitor</a>
			</div>
		)}

		{enriched.map(({ monitor, days, incidents, inMaintenance }) => (
			<section class="card mt-6 p-6 sm:p-7" data-monitor-id={monitor.id}>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<div class="flex items-center gap-3">
						<StatusDot status={inMaintenance ? 'pending' : monitor.current_status} />
						<div>
							<h2 class="font-semibold text-slate-900">{monitor.name}</h2>
							<p class="font-mono text-xs text-slate-400">{monitor.url}</p>
						</div>
					</div>
					<div class="flex items-center gap-2">
						{inMaintenance && (
							<span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">Maintenance</span>
						)}
						<span
							class:list={[
								'rounded-full px-2.5 py-1 text-xs font-semibold',
								inMaintenance ? 'bg-slate-100 text-slate-500' : monitor.current_status === 'up' ? 'bg-emerald-50 text-emerald-600'
									: monitor.current_status === 'down' ? 'bg-red-50 text-red-500'
									: 'bg-slate-100 text-slate-500',
							]}
							data-status={monitor.current_status}
						>{inMaintenance ? 'maintenance' : monitor.current_status}</span>
					</div>
				</div>
				<div class="mt-5">
					<UptimeBar days={days} />
				</div>
				{inMaintenance ? (
					<div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">This monitor is currently under maintenance — incidents are suppressed.</div>
				) : incidents.length > 0 && (
					<div class="mt-5 border-t border-slate-100 pt-4">
						<h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">Recent incidents</h3>
						<ul class="space-y-2">
							{incidents.map((inc) => (
								<li class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
									<span class:list={['size-1.5 rounded-full', inc.resolved_at ? 'bg-emerald-500' : 'bg-red-500']}></span>
									<span class="text-slate-600">{inc.cause}</span>
									<span class="ml-auto font-mono text-xs text-slate-400">{fmtUnix(inc.started_at)} · {duration(inc.started_at, inc.resolved_at)}{!inc.resolved_at && ' · ongoing'}</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		))}
		<div id="poll-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
	</main>
	<script define:vars={{ slug: slug }}>
		const pollEl = document.getElementById('poll-status');
		let lastData = null;
		async function poll() {
			try {
				const res = await fetch(`/api/status/${slug}`, { headers: { 'accept': 'application/json' }, cache: 'no-store' });
				if (!res.ok) return;
				const data = await res.json();
				const changed = JSON.stringify(data) !== JSON.stringify(lastData);
				if (lastData && changed && pollEl) {
					pollEl.textContent = `Status updated at ${new Date().toLocaleTimeString()}`;
				}
				// Update per-monitor status badges if DOM exists
				if (data.monitors && Array.isArray(data.monitors)) {
					for (const m of data.monitors) {
						const card = document.querySelector(`[data-monitor-id="${m.id}"]`);
						if (card) {
							const badge = card.querySelector('[data-status]');
							if (badge && badge.textContent.trim() !== m.status) {
								badge.textContent = m.status;
								badge.className = 'rounded-full px-2.5 py-1 text-xs font-semibold ' + (m.status === 'up' ? 'bg-emerald-50 text-emerald-600' : m.status === 'down' ? 'bg-red-50 text-red-500' : 'bg-slate-100 text-slate-500');
							}
						}
					}
				}
				lastData = data;
			} catch {}
		}
		// Initial fetch to set baseline, then poll every 30s when visible
		poll();
		setInterval(() => { if (!document.hidden) poll(); }, 30000);
		document.addEventListener('visibilitychange', () => { if (!document.hidden) poll(); });
	</script>
</Base>
