---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { listStatusPages, listMonitors, getStatusPageMonitorIds } from '../../lib/queries';

const pages = await listStatusPages(env);
const monitors = await listMonitors(env);

// enrich with monitor counts for display (optional)
const enriched = await Promise.all(
	pages.map(async (p) => {
		const ids = await getStatusPageMonitorIds(env, p.id);
		return { ...p, monitorCount: ids.length };
	})
);
---

<DashboardLayout title="Status Pages — UptimeCove" active="status-pages">
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<div>
						<h1 class="text-2xl font-bold tracking-tight text-slate-900">Status Pages</h1>
						<p class="mt-0.5 text-sm text-slate-500">Create branded status pages and organize which monitors they show.</p>
					</div>
					<a href="/status/default" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50">View public page ↗</a>
				</div>

				<div id="flash" class="mt-5 hidden rounded-2xl border border-blue-100 bg-blue-50 px-5 py-3 text-sm font-medium text-blue-700"></div>

				<!-- Create form -->
				<section class="card mt-7 p-6 sm:p-7">
					<h2 class="font-semibold text-slate-900">Create a status page</h2>
					<p class="mt-1 text-sm text-slate-500">A slug becomes the URL: <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs">/status/:slug</code></p>
					<form id="create-page-form" class="mt-4 grid gap-4">
						<div class="grid gap-4 sm:grid-cols-2">
							<label class="grid gap-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Title *</span>
								<input name="title" required placeholder="ACME Status" maxlength="120"
									class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
							<label class="grid gap-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Slug (optional)</span>
								<input name="slug" placeholder="acme" maxlength="48"
									class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 font-mono text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
						</div>
						<label class="grid gap-1.5">
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Description</span>
							<textarea name="description" rows="2" placeholder="We monitor our core services and report incidents here." maxlength="2000"
								class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"></textarea>
						</label>
						<div class="grid gap-4 sm:grid-cols-3">
							<label class="grid gap-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Branding logo URL</span>
								<input name="branding_logo_url" type="url" placeholder="https://example.com/logo.png"
									class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
							<label class="grid gap-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Theme</span>
								<select name="branding_theme" class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600 focus:border-blue-400 focus:outline-none">
									<option value="">Default</option>
									<option value="light">Light</option>
									<option value="dark">Dark</option>
									<option value="blue">Blue</option>
									<option value="emerald">Emerald</option>
								</select>
							</label>
							<label class="grid gap-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Custom domain</span>
								<input name="custom_domain" placeholder="status.example.com"
									class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 font-mono text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
						</div>
						<label class="flex items-center gap-2 text-sm font-medium text-slate-700">
							<input type="checkbox" name="is_public" checked class="size-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
							Public (visible without auth)
						</label>
						<div class="flex justify-end">
							<button class="rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm shadow-blue-600/25 transition hover:bg-blue-700">Create page</button>
						</div>
					</form>
				</section>

				<!-- List -->
				<section class="mt-8">
					<h2 class="text-lg font-bold text-slate-900">All pages</h2>
					<div class="card mt-4 overflow-hidden">
						{enriched.length === 0 ? (
							<div class="p-10 text-center text-sm text-slate-400">No status pages yet — create one above.</div>
						) : (
							<div class="divide-y divide-slate-100">
								{enriched.map((p) => (
									<div class="flex flex-wrap items-center justify-between gap-4 px-6 py-5">
										<div class="min-w-0">
											<div class="flex items-center gap-3">
												<a href={`/dashboard/status-pages/${p.id}`} class="font-semibold text-slate-900 hover:text-blue-600">{p.title}</a>
												<span class="rounded-full bg-slate-100 px-2.5 py-1 font-mono text-xs font-medium text-slate-500">/{p.slug}</span>
												<span class={`rounded-full px-2.5 py-1 text-xs font-semibold ${p.is_public ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600'}`}>{p.is_public ? 'Public' : 'Private'}</span>
											</div>
											{p.description && <p class="mt-1 max-w-2xl truncate text-sm text-slate-500">{p.description}</p>}
											<p class="mt-1 text-xs text-slate-400">{p.monitorCount} monitor{p.monitorCount === 1 ? '' : 's'} · {p.branding_theme ? `theme: ${p.branding_theme}` : 'default theme'}{p.custom_domain ? ` · ${p.custom_domain}` : ''}</p>
										</div>
										<div class="flex items-center gap-2">
											<a href={`/status/${p.slug}`} target="_blank" rel="noopener" class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50">View public →</a>
											<a href={`/dashboard/status-pages/${p.id}`} class="rounded-full bg-slate-900 px-4 py-1.5 text-xs font-semibold text-white hover:bg-slate-800">Edit</a>
											<button data-delete-id={p.id} class="delete-page-btn rounded-full border border-red-100 bg-white px-4 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50">Delete</button>
										</div>
									</div>
								))}
							</div>
						)}
					</div>
				</section>

				{monitors.length > 0 && (
					<section class="mt-10">
						<h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Quick note</h2>
						<p class="mt-2 text-sm leading-relaxed text-slate-500">Default page <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs">/status/default</code> shows all monitors when no specific monitors are assigned. Assign monitors explicitly to control ordering and visibility.</p>
					</section>
				)}
  </div>
  <script>// @ts-nocheck

		function flash(msg: string, ok = true) {
			const el = document.getElementById('flash')!;
			el.textContent = msg;
			el.className = `mt-5 rounded-2xl border px-5 py-3 text-sm font-medium ${ok ? 'border-blue-100 bg-blue-50 text-blue-700' : 'border-red-200 bg-red-50 text-red-600'}`;
			el.classList.remove('hidden');
			setTimeout(() => el.classList.add('hidden'), 3500);
		}
		document.getElementById('create-page-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const form = e.target as HTMLFormElement;
			const fd = new FormData(form);
			const payload: Record<string, unknown> = {
				title: String(fd.get('title') ?? '').trim(),
				slug: String(fd.get('slug') ?? '').trim() || undefined,
				description: String(fd.get('description') ?? '').trim() || null,
				branding_logo_url: String(fd.get('branding_logo_url') ?? '').trim() || null,
				branding_theme: String(fd.get('branding_theme') ?? '').trim() || null,
				custom_domain: String(fd.get('custom_domain') ?? '').trim() || null,
				is_public: (form.querySelector('input[name="is_public"]') as HTMLInputElement)?.checked ? 1 : 0,
			};
			try {
				const res = await fetch('/api/status-pages', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				const data = await res.json().catch(() => ({} as Record<string, unknown>));
				if (!res.ok) throw new Error((data as { error?: string }).error ?? res.statusText);
				flash(`Created "${(data as { page: { title: string } }).page.title}"`);
				setTimeout(() => location.reload(), 500);
			} catch (err) {
				flash((err as Error).message, false);
			}
		});
		document.querySelectorAll<HTMLButtonElement>('.delete-page-btn').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('Delete this status page? Monitor links will be removed.')) return;
				const id = btn.dataset.deleteId;
				try {
					const res = await fetch(`/api/status-pages/${id}`, { method: 'DELETE' });
					if (!res.ok) {
						const data = await res.json().catch(() => ({} as Record<string, unknown>));
						throw new Error((data as { error?: string }).error ?? res.statusText);
					}
					flash('Deleted');
					setTimeout(() => location.reload(), 400);
				} catch (err) {
					flash((err as Error).message, false);
				}
			});
		});
	</script>
</DashboardLayout>
