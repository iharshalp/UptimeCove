---
// @ts-nocheck
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { listApiKeys } from '../../lib/auth';
const keys = await listApiKeys(env);
---
<DashboardLayout title="API Keys — UptimeCove" active="api-keys">
  <div class="mx-auto max-w-4xl px-6 py-8">
      <h1 class="text-2xl font-bold text-slate-900">API Keys</h1>
      <p class="mt-1 text-sm text-slate-500">Use <code class="bg-slate-100 px-1 rounded">Authorization: Bearer uc_...</code> for /api/*</p>
      <form id="key-form" class="card mt-6 p-6 flex gap-3">
        <input name="name" placeholder="CI deploy key" required class="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm" />
        <input name="scopes" placeholder="read,write" value="read,write" class="w-48 rounded-xl border border-slate-200 px-4 py-2.5 text-sm" />
        <button class="rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white">Create</button>
      </form>
      <div id="plain" class="mt-4 hidden rounded-xl border border-amber-200 bg-amber-50 p-4">
        <div class="text-sm font-semibold text-amber-800">Copy your key now — it won't be shown again:</div>
        <code id="plain-code" class="mt-2 block break-all rounded bg-white p-3 font-mono text-sm"></code>
      </div>
      <div id="flash" class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600"></div>
      <div class="card mt-6 overflow-hidden">
        <table class="w-full text-left text-sm">
          <thead><tr class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-400"><th class="px-6 py-3">Name</th><th class="px-6 py-3">Scopes</th><th class="px-6 py-3">Last used</th><th class="px-6 py-3"></th></tr></thead>
          <tbody>{keys.map((k:any)=><tr class="border-b border-slate-50"><td class="px-6 py-3 font-medium">{k.name}</td><td class="px-6 py-3 font-mono text-xs">{k.scopes}</td><td class="px-6 py-3 text-slate-500">{k.last_used_at?new Date(k.last_used_at*1000).toLocaleString():'—'}</td><td class="px-6 py-3 text-right"><button data-id={k.id} class="del text-xs font-semibold text-red-600">Delete</button></td></tr>)}</tbody>
        </table>
        {keys.length===0 && <div class="p-8 text-center text-sm text-slate-400">No keys yet.</div>}
      </div>
      <a href="/dashboard" class="mt-6 inline-block text-sm font-medium text-blue-600">← Back</a>
    </div>
  <script>// @ts-nocheck

    const f=document.getElementById('key-form') as HTMLFormElement, plain=document.getElementById('plain')!, code=document.getElementById('plain-code')!, flash=document.getElementById('flash')!;
    f?.addEventListener('submit', async e=>{e.preventDefault();const d=new FormData(f);const r=await fetch('/api/api-keys',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({name:d.get('name'),scopes:d.get('scopes')})});const j=await r.json().catch(()=>({}));if(!r.ok){flash.textContent=(j as any).error||'Failed';flash.classList.remove('hidden');return;}code.textContent=(j as any).plainKey||(j as any).key||'';plain.classList.remove('hidden');setTimeout(()=>location.reload(),2500);});
    document.querySelectorAll('.del').forEach(b=>b.addEventListener('click', async()=>{if(!confirm('Delete key?'))return;const r=await fetch(`/api/api-keys/${(b as HTMLElement).dataset.id}/delete`,{method:'POST'});if(r.ok)location.reload();}));
  </script>
</DashboardLayout>
