---
// @ts-nocheck
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
import { listMonitors } from '../../lib/queries';
import { listMaintenanceWindows } from '../../lib/queries';

const monitors = await listMonitors(env);
const windows = await listMaintenanceWindows(env);

function fmt(ts: number): string {
	return new Date(ts * 1000).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function isActive(w: { start_at: number; end_at: number; enabled: number }): boolean {
	const now = Math.floor(Date.now() / 1000);
	return w.enabled === 1 && w.start_at <= now && now <= w.end_at;
}
function isUpcoming(w: { start_at: number }): boolean {
	return w.start_at > Math.floor(Date.now() / 1000);
}
---

<DashboardLayout title="Maintenance — UptimeCove" active="maintenance">
  <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8">
				<div class="flex flex-wrap items-center justify-between gap-4">
					<div>
						<h1 class="text-2xl font-bold tracking-tight text-slate-900">Maintenance windows</h1>
						<p class="mt-0.5 text-sm text-slate-500">Schedule downtime to suppress alerts and incidents. Monitors are still checked but failures won't create incidents.</p>
					</div>
					<span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">{windows.length} window{windows.length === 1 ? '' : 's'}</span>
				</div>

				<div id="flash" class="mt-5 hidden rounded-2xl border px-5 py-3 text-sm font-medium"></div>

				<section class="card mt-6 p-6 sm:p-7">
					<h2 class="font-semibold text-slate-900">Create window</h2>
					<form id="mw-form" class="mt-4 grid gap-4">
						<div class="grid gap-3 sm:grid-cols-2">
							<label class="space-y-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Title *</span>
								<input id="mw-title" required maxlength="200" placeholder="Deploy window — API upgrade"
									class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-800 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
							<label class="space-y-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Monitor</span>
								<select id="mw-monitor"
									class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10">
									<option value="">Global — all monitors</option>
									{monitors.map((m) => (
										<option value={String(m.id)}>{m.name} — {m.url}</option>
									))}
								</select>
							</label>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							<label class="space-y-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Start *</span>
								<input id="mw-start" type="datetime-local" required
									class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
							<label class="space-y-1.5">
								<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">End *</span>
								<input id="mw-end" type="datetime-local" required
									class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10" />
							</label>
						</div>
						<label class="space-y-1.5">
							<span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Description</span>
							<textarea id="mw-desc" rows="2" maxlength="2000" placeholder="Optional — brief reason for maintenance"
								class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-700 placeholder:text-slate-400 focus:border-blue-400 focus:bg-white focus:outline-none focus:ring-4 focus:ring-blue-500/10"></textarea>
						</label>
						<div class="flex justify-end">
							<button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm shadow-blue-600/25 transition hover:bg-blue-700">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
								Create window
							</button>
						</div>
					</form>
				</section>

				<section class="mt-8">
					<h2 class="text-lg font-bold text-slate-900">Scheduled windows</h2>
					<div class="card mt-4 overflow-hidden">
						{windows.length === 0 ? (
							<div class="p-10 text-center">
								<p class="font-semibold text-slate-700">No maintenance windows.</p>
								<p class="mt-1 text-sm text-slate-500">Create one above — global windows apply to every monitor.</p>
							</div>
						) : (
							<div class="divide-y divide-slate-100">
								{windows.map((w) => {
									const active = isActive(w);
									const upcoming = isUpcoming(w);
									const statusCls = active ? 'bg-amber-50 text-amber-700 border-amber-200' : upcoming ? 'bg-blue-50 text-blue-600 border-blue-200' : 'bg-slate-100 text-slate-500 border-slate-200';
									const statusLabel = active ? 'Active' : upcoming ? 'Upcoming' : 'Ended';
									return (
										<div class="flex flex-wrap items-start justify-between gap-4 p-5">
											<div class="min-w-0 flex-1">
												<div class="flex flex-wrap items-center gap-2">
													<h3 class="font-semibold text-slate-900">{w.title}</h3>
													<span class={`inline-flex items-center gap-1 rounded-full border px-2.5 py-1 text-xs font-semibold ${statusCls}`}>
														<span class={`size-1.5 rounded-full ${active ? 'bg-amber-500' : upcoming ? 'bg-blue-500' : 'bg-slate-400'}`}></span>
														{statusLabel}
													</span>
													<span class="rounded-full bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-500">
														{w.monitor_name ? `${w.monitor_name}` : 'Global'}
													</span>
												</div>
												<div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-slate-400">
													<span>{fmt(w.start_at)} → {fmt(w.end_at)}</span>
													{w.monitor_url && <span class="truncate">{w.monitor_url}</span>}
												</div>
												{w.description && (
													<p class="mt-2 whitespace-pre-wrap text-sm text-slate-600">{w.description}</p>
												)}
											</div>
											<button data-delete={w.id} class="delete-mw inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600">
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18m-2 0-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m5 0V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"/></svg>
												Delete
											</button>
										</div>
									);
								})}
							</div>
						)}
					</div>
				</section>
  </div>
  <script>// @ts-nocheck

		function flash(msg, isError=false) {
			const el = document.getElementById('flash');
			el.textContent = msg;
			el.className = isError ? 'mt-5 rounded-2xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-medium text-red-600' : 'mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3 text-sm font-medium text-emerald-700';
			el.classList.remove('hidden');
			setTimeout(() => el.classList.add('hidden'), 4000);
		}
		function toUnixSeconds(dtLocal) {
			const ms = Date.parse(dtLocal);
			return Math.floor(ms / 1000);
		}
		document.getElementById('mw-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const title = (document.getElementById('mw-title') as HTMLInputElement).value.trim();
			const monitor_id = (document.getElementById('mw-monitor') as HTMLSelectElement).value || null;
			const startRaw = (document.getElementById('mw-start') as HTMLInputElement).value;
			const endRaw = (document.getElementById('mw-end') as HTMLInputElement).value;
			const description = (document.getElementById('mw-desc') as HTMLTextAreaElement).value.trim();
			if (!title || !startRaw || !endRaw) { flash('Title, start and end are required', true); return; }
			const start_at = toUnixSeconds(startRaw);
			const end_at = toUnixSeconds(endRaw);
			if (!Number.isFinite(start_at) || !Number.isFinite(end_at)) { flash('Invalid dates', true); return; }
			if (start_at >= end_at) { flash('End must be after start', true); return; }
			const btn = (e.target as HTMLFormElement).querySelector('button[type=submit]') as HTMLButtonElement;
			btn.disabled = true; const orig = btn.textContent; btn.textContent = 'Creating…';
			try {
				const payload = { title, description: description || null, monitor_id: monitor_id ? Number(monitor_id) : null, start_at, end_at };
				const res = await fetch('/api/maintenance', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				const data = await res.json().catch(() => ({}));
				if (!res.ok) throw new Error((data as any).error || res.statusText);
				flash('Maintenance window created');
				setTimeout(() => location.reload(), 700);
			} catch (err) {
				flash(`Failed: ${(err as Error).message}`, true);
				btn.disabled = false; btn.textContent = orig;
			}
		});
		document.querySelectorAll('.delete-mw').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('Delete this maintenance window?')) return;
				const id = (btn as HTMLElement).dataset.delete;
				(btn as HTMLButtonElement).disabled = true;
				try {
					const res = await fetch(`/api/maintenance/${id}/delete`, { method: 'POST' });
					if (!res.ok && res.status !== 204) {
						const d = await res.json().catch(() => ({}));
						throw new Error((d as any).error || res.statusText);
					}
					flash('Deleted');
					setTimeout(() => location.reload(), 600);
				} catch (err) {
					flash(`Failed: ${(err as Error).message}`, true);
					(btn as HTMLButtonElement).disabled = false;
				}
			});
		});
	</script>
</DashboardLayout>
