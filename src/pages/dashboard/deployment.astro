---
// @ts-nocheck
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';
const tpls = await env.DB.prepare(`SELECT * FROM deployment_templates ORDER BY created_at DESC`).all().then(r=>r.results??[]);
---
<DashboardLayout title="Deployment — UptimeCove" active="deployment">
  <div class="mx-auto max-w-4xl px-6 py-8">
      <h1 class="text-2xl font-bold text-slate-900">Deployment Templates</h1>
      <p class="mt-1 text-sm text-slate-500">Cloudflare-native templates. SaaS mode is a flag: set <code class="bg-slate-100 px-1 rounded">SAAS_MODE=1</code> in wrangler vars.</p>
      <div class="mt-6 grid gap-4">
        {tpls.map((t:any)=><div class="card p-6"><div class="font-semibold text-slate-900">{t.name}</div><div class="mt-1 text-sm text-slate-500">{t.description}</div><pre class="mt-3 overflow-auto rounded-xl bg-slate-900 p-4 text-xs text-slate-300">{t.wrangler_config}</pre><div class="mt-3 text-xs font-mono text-slate-400">ID: {t.id}</div></div>)}
      </div>
      <div class="card mt-6 p-6">
        <h2 class="font-semibold text-slate-900">Private Agent</h2>
        <p class="mt-1 text-sm text-slate-500">Run checks from your own network. Agents poll <code class="bg-slate-100 px-1 rounded">/api/agent/poll</code> and post to <code class="bg-slate-100 px-1 rounded">/api/agent/report</code> (stub in this prototype).</p>
        <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-700">Private agents are stubbed: implement ed25519 verification and queue dispatch in production.</div>
      </div>
      <a href="/dashboard" class="mt-6 inline-block text-sm font-medium text-blue-600">← Back</a>
    </div>
  </DashboardLayout>
