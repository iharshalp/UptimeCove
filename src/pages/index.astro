---
import Base from '../layouts/Base.astro';
import StatusDot from '../components/StatusDot.astro';
import Sparkline from '../components/Sparkline.astro';

const features = [
	{
		title: 'Runs on your Cloudflare account',
		desc: 'Workers Cron, D1 and KV do all the work. No servers to babysit, no bills to dread — the free tier covers most setups.',
		icon: 'M12 3v18m0-18a9 9 0 0 1 9 9m-9-9a9 9 0 0 0-9 9m18 0a9 9 0 0 1-9 9',
	},
	{
		title: 'Checks from the edge',
		desc: 'Monitors run on the edge with per-minute scheduling, expected status codes, and validated GET/HEAD checks.',
		icon: 'M13 2L4.5 12.5H11l-1 8.5L19.5 10H12l1-8z',
	},
	{
		title: 'Status pages worth sharing',
		desc: 'Publish one fast public status page with 90-day uptime bars and incident history for the monitors you choose.',
		icon: 'M4 19V9m5 10V5m5 14v-7m5 7V8',
	},
	{
		title: 'Incidents, automatically',
		desc: 'Two consecutive failures open an incident. Recovery closes it. Your history is written down — no spreadsheets required.',
		icon: 'M12 9v4m0 4h.01M10.3 3.9L2 18a2 2 0 0 0 1.7 3h16.6A2 2 0 0 0 22 18L13.7 3.9a2 2 0 0 0-3.4 0z',
	},
];

const mockSeries = (seed: number) =>
	Array.from({ length: 24 }, (_, i) => 120 + Math.round(Math.sin(i * 0.9 + seed) * 40 + Math.cos(i * 0.4 + seed * 2) * 25));
---

<Base>
	<!-- Nav -->
	<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
		<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
			<a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-slate-900">
				<span class="flex size-8 items-center justify-center rounded-lg bg-blue-600">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg>
				</span>
				UptimeCove
			</a>
			<div class="flex items-center gap-4">
				<a href="/status/default" class="hidden text-sm font-medium text-slate-600 transition hover:text-slate-900 sm:block">Live demo</a>
				<a href="https://github.com/iharshalp/UptimeCove" target="_blank" rel="noopener noreferrer" class="hidden items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50 sm:inline-flex" aria-label="GitHub stars">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-amber-400"><path d="M12 2l2.4 7.2h7.6l-6.1 4.4 2.3 7.2L12 16.4l-6.2 4.4 2.3-7.2-6.1-4.4h7.6z"/></svg>
					<span>Star</span>
					<img src="https://img.shields.io/github/stars/iharshalp/UptimeCove?style=social" alt="GitHub stars" class="h-5" loading="lazy" />
				</a>
				<a href="https://github.com/iharshalp" target="_blank" rel="noopener noreferrer" class="hidden text-sm font-medium text-slate-500 hover:text-slate-700 sm:block" aria-label="Author">iharshalp</a>
				<a href="https://github.com/iharshalp/UptimeCove" target="_blank" rel="noopener noreferrer" class="text-slate-400 transition hover:text-slate-700" aria-label="Project GitHub">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
				</a>
				<a href="/demo" class="rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm shadow-blue-600/30 transition hover:bg-blue-700">Demo Dashboard</a>
			</div>
		</nav>
	</header>

	<main>
		<!-- Hero -->
		<section class="hero-glow pt-32 pb-20">
			<div class="mx-auto max-w-6xl px-6">
				<div class="mx-auto max-w-3xl text-center">
					<p class="mb-5 inline-flex items-center gap-2 rounded-full border border-blue-100 bg-blue-50 px-4 py-1.5 text-xs font-semibold text-blue-700">
						<span class="size-1.5 rounded-full bg-blue-600"></span>
						100% free · runs on your own Cloudflare account
					</p>
					<h1 class="text-5xl font-extrabold tracking-tight text-slate-900 sm:text-6xl md:text-7xl">
						Uptime monitoring<br />
						<span class="bg-gradient-to-r from-blue-600 via-blue-500 to-emerald-500 bg-clip-text text-transparent">without the invoice.</span>
					</h1>
					<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-500">
						Open-source status pages &amp; uptime checks that deploy to Cloudflare Workers in one click.
						Your data stays in <span class="font-semibold text-slate-700">your</span> D1 database. Forever free.
					</p>
					<div class="mt-9 flex flex-wrap items-center justify-center gap-4">
						<a href="/demo" class="group inline-flex items-center gap-2 rounded-full bg-blue-600 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">
							Open Demo Dashboard
							<svg class="transition-transform group-hover:translate-x-0.5" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
						</a>
						<code class="rounded-full border border-slate-200 bg-white px-5 py-3.5 font-mono text-sm text-slate-600 shadow-sm">git clone · npm install · wrangler deploy</code>
					</div>
				</div>

				<!-- Hero mock: mini dashboard -->
				<div class="mx-auto mt-16 max-w-5xl rounded-3xl border border-slate-200 bg-white p-4 shadow-2xl shadow-slate-900/10 sm:p-6">
					<div class="grid gap-4 sm:grid-cols-4">
						{[
							{ label: 'Active Monitors', value: '3', icon: 'M13 2L4.5 12.5H11l-1 8.5L19.5 10H12l1-8z', chip: 'bg-blue-50 text-blue-600' },
							{ label: 'Status Pages', value: '1', icon: 'M4 19V9m5 10V5m5 14v-7m5 7V8', chip: 'bg-indigo-50 text-indigo-500' },
							{ label: 'Incidents', value: '0', icon: 'M12 9v4m0 4h.01M10.3 3.9L2 18a2 2 0 0 0 1.7 3h16.6A2 2 0 0 0 22 18L13.7 3.9a2 2 0 0 0-3.4 0z', chip: 'bg-red-50 text-red-500' },
							{ label: 'Global Uptime', value: '99.99%', icon: 'M20 6L9 17l-5-5', chip: 'bg-emerald-50 text-emerald-600' },
						].map((s) => (
							<div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
								<div class="text-sm font-medium text-slate-500">{s.label}</div>
								<div class="mt-3 flex items-center gap-3">
									<span class={`flex size-10 items-center justify-center rounded-xl ${s.chip}`}>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon} /></svg>
									</span>
									<span class="text-2xl font-bold text-slate-900">{s.value}</span>
								</div>
							</div>
						))}
					</div>
					<div class="mt-4 grid gap-4 sm:grid-cols-3">
						{[
							{ name: 'api.uptimecove.com', up: true, pct: '99.99%', ms: '182 ms', seed: 1 },
							{ name: 'app.uptimecove.com', up: true, pct: '99.94%', ms: '246 ms', seed: 4 },
							{ name: 'cdn.uptimecove.com', up: true, pct: '100%', ms: '64 ms', seed: 7 },
						].map((m) => (
							<div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
								<div class="flex items-center gap-3">
									<StatusDot status="up" />
									<div class="min-w-0">
										<div class="truncate text-sm font-semibold text-slate-800">{m.name}</div>
										<div class="text-xs text-slate-400">{m.pct} · {m.ms}</div>
									</div>
								</div>
								<div class="mt-3"><Sparkline points={mockSeries(m.seed)} height={64} /></div>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- Features -->
		<section class="py-24">
			<div class="mx-auto max-w-6xl px-6">
				<h2 class="max-w-lg text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
					Built for people who read invoices.
				</h2>
				<p class="mt-3 max-w-xl text-slate-500">
					UptimeRobot charges $29/mo for what your free Cloudflare plan already includes.
				</p>
				<div class="mt-12 grid gap-5 sm:grid-cols-2">
					{features.map((f) => (
						<div class="card group p-7 transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-900/5">
							<div class="mb-5 flex size-11 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon} /></svg>
							</div>
							<h3 class="text-lg font-semibold text-slate-900">{f.title}</h3>
							<p class="mt-2 leading-relaxed text-slate-500">{f.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Easy Setup -->
		<section class="py-16">
			<div class="mx-auto max-w-6xl px-6">
				<div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<div>
							<h2 class="text-2xl font-bold tracking-tight text-slate-900">Get started in 30 seconds</h2>
							<p class="mt-1 text-sm text-slate-500">Clone, set your <code class="rounded bg-slate-100 px-1">ADMIN_TOKEN</code>, migrate, and you’re live. No manual D1/KV ids — auto-provisioned.</p>
						</div>
						<a href="https://github.com/iharshalp/UptimeCove" target="_blank" class="hidden items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-white sm:inline-flex">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
							iharshalp/UptimeCove
						</a>
					</div>
					<div class="mt-8 grid gap-6 md:grid-cols-3">
						<div>
							<div class="font-mono text-xs font-semibold text-blue-600">01 — Clone & install</div>
							<pre class="mt-3 overflow-auto rounded-2xl bg-slate-900 p-4 font-mono text-xs leading-relaxed text-slate-300"><code>git clone https://github.com/iharshalp/UptimeCove.git
cd UptimeCove
npm install</code></pre>
						</div>
						<div>
							<div class="font-mono text-xs font-semibold text-blue-600">02 — Configure & migrate</div>
							<pre class="mt-3 overflow-auto rounded-2xl bg-slate-900 p-4 font-mono text-xs leading-relaxed text-slate-300"><code>cp .dev.vars.example .dev.vars
# set ADMIN_TOKEN in .dev.vars
npm run db:migrate
npm run dev</code></pre>
						</div>
						<div>
							<div class="font-mono text-xs font-semibold text-blue-600">03 — Deploy</div>
							<pre class="mt-3 overflow-auto rounded-2xl bg-slate-900 p-4 font-mono text-xs leading-relaxed text-slate-300"><code>npm run build
npx wrangler deploy
npx wrangler secret put ADMIN_TOKEN</code></pre>
						</div>
					</div>
					<div class="mt-6 flex flex-wrap gap-3 text-sm">
						<a href="https://github.com/iharshalp/UptimeCove" target="_blank" class="font-medium text-blue-600 hover:underline">Project → iharshalp/UptimeCove</a>
						<span class="text-slate-300">•</span>
						<a href="https://github.com/iharshalp" target="_blank" class="font-medium text-slate-600 hover:text-slate-900">Author → iharshalp</a>
						<span class="text-slate-300">•</span>
						<a href="/docs" class="font-medium text-slate-600 hover:text-slate-900">API Docs →</a>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA -->
		<section class="pb-24">
			<div class="mx-auto max-w-6xl px-6">
				<div class="rounded-3xl bg-gradient-to-br from-blue-600 to-blue-800 px-8 py-16 text-center shadow-2xl shadow-blue-600/25 sm:px-16">
					<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Your monitoring bill is about to hit zero.</h2>
					<p class="mx-auto mt-3 max-w-md text-blue-100">Deploy in minutes. Keep the data forever. Pay nothing.</p>
					<a href="/demo" class="mt-8 inline-block rounded-full bg-white px-8 py-3.5 text-base font-semibold text-blue-700 shadow-lg transition hover:bg-blue-50">Open Demo Dashboard →</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-slate-200 bg-white py-10">
		<div class="mx-auto flex max-w-6xl flex-col gap-6 px-6">
			<div class="flex flex-col items-center justify-between gap-4 text-sm text-slate-500 sm:flex-row">
				<span class="flex items-center gap-2">
					<span class="flex size-6 items-center justify-center rounded-md bg-blue-600"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg></span>
					© {new Date().getFullYear()} UptimeCove · MIT licensed
				</span>
				<span>Built with <a href="https://astro.build" class="font-medium text-slate-700 hover:text-blue-600">Astro</a> + <a href="https://workers.cloudflare.com" class="font-medium text-slate-700 hover:text-blue-600">Cloudflare</a></span>
			</div>
			<div class="flex flex-wrap items-center justify-center gap-4 border-t border-slate-100 pt-6 text-sm">
				<a href="https://github.com/iharshalp/UptimeCove" target="_blank" class="inline-flex items-center gap-2 font-medium text-slate-700 hover:text-slate-900">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
					iharshalp/UptimeCove
					<img src="https://img.shields.io/github/stars/iharshalp/UptimeCove?style=social" alt="stars" class="h-5" loading="lazy" />
				</a>
				<span class="text-slate-300">•</span>
				<a href="https://github.com/iharshalp" target="_blank" class="font-medium text-slate-500 hover:text-slate-700">github.com/iharshalp</a>
				<span class="text-slate-300">•</span>
				<a href="https://github.com/iharshalp/UptimeCove/issues" target="_blank" class="font-medium text-slate-500 hover:text-slate-700">Issues</a>
				<span class="text-slate-300">•</span>
				<a href="https://github.com/iharshalp/UptimeCove/blob/main/LICENSE" target="_blank" class="font-medium text-slate-500 hover:text-slate-700">MIT</a>
			</div>
		</div>
	</footer>
</Base>
