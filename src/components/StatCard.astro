---
interface Props {
	label: string;
	value: string;
	tone?: 'blue' | 'green' | 'pink' | 'orange';
	icon: string; // svg path d
}
const { label, value, tone = 'blue', icon } = Astro.props;
const tones = {
	blue: { chip: 'bg-brand-50 text-brand-500', glyph: 'M4 19V9m5 10V5m5 14v-7m5 7V8' },
	green: { chip: 'bg-ok-chip text-ok-600', glyph: 'm5 13 4 4L19 7' },
	pink: { chip: 'bg-bad-chip text-bad-600', glyph: 'M12 9v4m0 4h.01M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6A2 2 0 0 0 22 18 2 2 0 0 0 20.3 15 2 2 0 0 0 13.7 3.9a2 2 0 0 0-3.4 0z' },
	orange: { chip: 'bg-warn-chip text-warn-500', glyph: 'M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0z' },
} as const;
const t = tones[tone] ?? tones.blue;
---

<div class="card flex items-center gap-4 p-5">
	<span class={`chip size-11 shrink-0 ${t.chip}`}>
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icon || t.glyph}></path></svg>
	</span>
	<div class="min-w-0">
		<div class="truncate text-[13px] font-medium text-ink-500">{label}</div>
		<div class="mt-0.5 truncate text-2xl font-bold tracking-tight text-ink-900">{value}</div>
	</div>
</div>
