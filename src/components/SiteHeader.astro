---
// Slim nav for content/legal pages. The landing page keeps its own hero-styled
// header; everything else shares this one so navigation never dead-ends.
interface Props {
	/** Pathname of the current page, used to mark the active link. */
	current?: string;
}

const { current = Astro.url.pathname } = Astro.props;

const links = [
	{ href: '/docs', label: 'API Docs' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
		<a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-slate-900">
			<span class="flex size-8 items-center justify-center rounded-lg bg-blue-600">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M2 12h4l3-8 4 16 3-8h6"/></svg>
			</span>
			UptimeCove
		</a>
		<div class="flex items-center gap-5">
			{links.map((link) => (
				<a
					href={link.href}
					aria-current={current === link.href ? 'page' : undefined}
					class:list={[
						'hidden text-sm font-medium transition sm:block',
						current === link.href ? 'text-blue-600' : 'text-slate-600 hover:text-slate-900',
					]}
				>{link.label}</a>
			))}
			<a href="https://github.com/iharshalp/UptimeCove" target="_blank" rel="noopener noreferrer" class="text-slate-400 transition hover:text-slate-700" aria-label="Project on GitHub">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
			</a>
			<a href="/demo" class="rounded-full bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm shadow-blue-600/30 transition hover:bg-blue-700">Demo Dashboard</a>
		</div>
	</nav>
</header>
